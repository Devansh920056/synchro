# ─── DATABASE ──────────────────────────────────────────────────────────
# A connection string to your PostgreSQL database.
# You can get a free one from Supabase (supabase.com) or Neon (neon.tech),
# or run one locally via Docker.
DATABASE_URL="postgresql://username:password@localhost:5432/synchro"

# Used by Prisma for migrations. If you don't use a connection pooler,
# set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://username:password@localhost:5432/synchro"

# ─── AUTHENTICATION (Auth.js) ────────────────────────────────────────
# Generate a secret using: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your_generated_secret_here"

# Optional: GitHub OAuth (Create at https://github.com/settings/developers)
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# Optional: Discord OAuth (Create at https://discord.com/developers/applications)
AUTH_DISCORD_ID="your_discord_client_id"
AUTH_DISCORD_SECRET="your_discord_client_secret"

# ─── SERVER (optional, these are the defaults) ───────────────────────
# Port the game server listens on
PORT=3001
# The website address the game server accepts connections from
CLIENT_ORIGIN="http://localhost:3000"
# Where the website finds the game server (put in packages/frontend/.env.local)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
